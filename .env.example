# Copy to .env locally, replace the required values, and never commit .env.
POSTGRES_DB=employee_lifecycle_sync
POSTGRES_USER=employee_sync
POSTGRES_PASSWORD=
DB_USERNAME=employee_sync
DB_PASSWORD=
ADMIN_USERNAME=
# Use a BCrypt hash generated for your own local demo password.
# In .env, surround the complete hash with single quotes to keep its $ characters literal.
ADMIN_PASSWORD_HASH=
MOCK_HR_ENABLED=true
MOCK_HR_SCENARIO=initial
MOCK_GROUPWARE_ENABLED=true
INTEGRATION_WORKER_ENABLED=true
OPENAPI_ENABLED=false
